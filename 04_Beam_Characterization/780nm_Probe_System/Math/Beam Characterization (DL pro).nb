    RowBox[{"Height", " ", "From", " ", "Table"}], ",", " ", "z"}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Combine", " ", "measurements", " ", "to", " ", "make", " ", "functions", 
    " ", "of", " ", "distanceY"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"widthBeam2", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#2", "[", 
