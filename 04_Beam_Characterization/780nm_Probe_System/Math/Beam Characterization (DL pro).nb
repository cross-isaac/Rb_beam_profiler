 RowBox[{
  RowBox[{
   RowBox[{"heightFromTable2", " ", "=", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#2", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"ErrorBar", "[", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"heightFromTable", ",", " ", 
        RowBox[{"Drop", "[", 
         RowBox[{"distanceY", ",", " ", 
          RowBox[{"-", "1"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Function", " ", "to", " ", "create", " ", "simple", " ", "plots"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"createSimplePlot", "[", 
     RowBox[{"measurement_", ",", " ", "y_", ",", " ", "x_"}], "]"}], " ", ":=",
     " ", 
    RowBox[{"ErrorListPlot", "[", "\n", "  ", 
     RowBox[{"measurement", ",", "\n", "  ", 
      RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
      RowBox[{"PlotStyle", " ", "->", " ", "Blue"}], ",", "\n", "  ", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"Joined", " ", "->", " ", "True"}]}], "\n", "]"}]}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Function", " ", "to", " ", "perform", " ", "linear", " ", "fit"}], ",", 
    " ", "plot", ",", " ", 
    RowBox[{"and", " ", "print", " ", 
     RowBox[{"slope", "/", "uncertainty"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"linearFitPlot", "[", 
     RowBox[{
     "measurementData_", ",", " ", "yLabel_", ",", " ", "xLabel_", ",", " ", 
      "plotName_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "xVals", ",", " ", "yVals", ",", " ", "linearModel", ",", " ", "slope",
         ",", " ", "intercept", ",", " ", "slopeUncertainty", ",", " ", 
        "equation"}], "}"}], ",", "\n", "  ", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Extract", " ", "x", " ", "and", " ", "y", " ", "values", " ", "from", 
        " ", "the", " ", "measurement", " ", "data"}], " ", "*)"}], "\n", 
      "  ", 
      RowBox[{
       RowBox[{"xVals", " ", "=", " ", 
        RowBox[{"measurementData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"yVals", " ", "=", " ", 
        RowBox[{"measurementData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1", ",", " ", "2"}], "]"}], "]"}]}], ";", 
       "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Perform", " ", "the", " ", "linear", " ", "fit", " ", "using", " ", 
         "LinearModelFit"}], " ", "*)"}], "\n", "  ", 
       RowBox[{"linearModel", " ", "=", " ", 
        RowBox[{"LinearModelFit", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xVals", ",", " ", "yVals"}], "}"}], "]"}], ",", " ", "x",
           ",", " ", "x"}], "]"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Extract", " ", "the", " ", "slope"}], ",", " ", "intercept",
          ",", " ", 
         RowBox[{"and", " ", "their", " ", "uncertainties"}]}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"intercept", " ", "=", " ", 
        RowBox[{
         RowBox[{"linearModel", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Intercept", " ", "is", " ", "the", " ", "first", " ", "parameter"}], 
        " ", "*)"}], "\n", "  ", 
       RowBox[{"slope", " ", "=", " ", 
        RowBox[{
         RowBox[{"linearModel", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "     ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Slope", " ", "is", " ", "the", " ", "second", " ", "parameter"}], 
        " ", "*)"}], "\n", "  ", 
       RowBox[{"slopeUncertainty", " ", "=", " ", 
        RowBox[{
         RowBox[{"linearModel", "[", "\"\<ParameterErrors\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"Uncertainty", " ", "for", " ", "slope"}], " ", "*)"}], "\n", 
       "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Create", " ", "the", " ", "equation", " ", "string"}], " ", 
        "*)"}], "\n", "  ", 
       RowBox[{"equation", " ", "=", " ", 
        RowBox[{"\"\<y = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "slope", "]"}], " ", "<>", " ", 
         "\"\< x + \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "intercept", "]"}]}]}], ";", "\n", "  ", 
       "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Print", " ", "the", " ", "equation", " ", "and", " ", "the", " ", 
         "uncertainty", " ", "with", " ", "a", " ", "descriptive", " ", 
         "label"}], " ", "*)"}], "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Best Fit Equation for \>\"", ",", " ", "plotName", ",", " ", 
         "\"\<: \>\"", ",", " ", "equation"}], "]"}], ";", "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Uncertainty in Slope for \>\"", ",", " ", "plotName", ",", " ", 
         "\"\<: \>\"", ",", " ", "slopeUncertainty"}], "]"}], ";", "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Divergence Angle for \>\"", ",", " ", "plotName", ",", " ", 
         "\"\<: \>\"", ",", " ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcTan", "[", "slope", "]"}], "/", "Degree"}], ",", " ", 
           "Underlined"}], "]"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Create", " ", "and", " ", "return", " ", "the", " ", "plot", " ", 
         "with", " ", "the", " ", "linear", " ", "fit"}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"Show", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"createSimplePlot", "[", 
          RowBox[{"measurementData", ",", " ", "yLabel", ",", " ", "xLabel"}],
           "]"}], ",", "\n", "    ", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"linearModel", "[", "x", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", 
             RowBox[{"Min", "[", "xVals", "]"}], ",", " ", 
             RowBox[{"Max", "[", "xVals", "]"}]}], "}"}], ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", "Red"}]}], "]"}]}], "\n", 
        "  ", "]"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Generating", " ", "plots", " ", "using", " ", "the", " ", "linearFitPlot",
     " ", "function"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"distanceYPlot", " ", "=", " ", 
   RowBox[{"createSimplePlot", "[", 
