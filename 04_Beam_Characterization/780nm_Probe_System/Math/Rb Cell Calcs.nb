Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Use", " ", "Beer"}], "-", 
    RowBox[{
    "Lambert", " ", "Law", " ", "to", " ", "find", " ", "expected", " ", 
     "Absortion", " ", "and", " ", "then", " ", "use", " ", "this", " ", "to",
      " ", "find", " ", "diffrence", " ", "in", " ", "intensity", " ", "we", 
     " ", "expect"}]}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Absorption", " ", "=", " ", 
    RowBox[{"absorption", "-", "cross", "-", 
     RowBox[{"section", " ", "x", " ", "concentraition"}], "-", 
     RowBox[{"Rb", " ", "x", " ", "Length"}], "-", "path"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]780", " ", "=", " ", "780*^-9"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"K", " ", "=", " ", "1.38*^-23"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"J", "/", " ", "k"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"T", " ", "=", " ", "300"}], ";"}], " ", 
   RowBox[{"(*", "k", "*)"}], "\n", 
   RowBox[{
    RowBox[{"P", " ", "=", " ", 
     RowBox[{"133.322", "*", " ", "5.3*^-7"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"torr", " ", "to", " ", "Pa"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"RbAbsorptionCrossSection", " ", "=", " ", 
     RowBox[{"N", "[", 
      FractionBox[
       RowBox[{"3", "*", 
        RowBox[{"\[Lambda]780", "^", "2"}]}], 
       RowBox[{"2", " ", "Pi"}]], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "From", " ", "sharika", " ", "Refrence", " ", "cell", " ", 
      "calculations"}], ",", " ", 
     RowBox[{
     "and", " ", "proportional", " ", "to", " ", "atomic", " ", "physics", 
      " ", "pg", " ", "eq", " ", "3.146"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"NumberDensity", " ", "=", " ", 
     RowBox[{"P", "/", 
      RowBox[{"(", 
       RowBox[{"K", "*", "T"}], ")"}]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Using", " ", "ideal", " ", "gas", " ", "law"}], " ", "=", 
      RowBox[{"N", "/", "V"}]}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{"Atoms", "/", 
      RowBox[{"m", "^", "3"}]}], "*)"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pathLength", " ", "=", " ", ".002"}], " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"~", "2"}], " ", "cm"}], "*)"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"MtoCm", " ", "=", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "12"}]]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"m", "^", "6"}], " ", "to", " ", 
     RowBox[{"cm", "^", "6"}]}], "*)"}], "\n", 
   RowBox[{"OpticalDepth", " ", "=", " ", 
    RowBox[{
    "RbAbsorptionCrossSection", "*", "NumberDensity", "*", "pathLength", "*", 
     "MtoCm"}]}], "\n", 
   RowBox[{"Exp", "[", "OpticalDepth", "]"}]}]}]], "Code",
 CellChangeTimes->{{3.9319665548923035`*^9, 3.931966681122461*^9}, {
  3.9320375096987658`*^9, 3.9320375778493433`*^9}, {3.932037613688236*^9, 
