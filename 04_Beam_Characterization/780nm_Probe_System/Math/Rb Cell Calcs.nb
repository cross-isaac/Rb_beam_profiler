Cell[CellGroupData[{

Cell["\<\
Calculating Theoretical Cross section/absorption coefficients\
\>", "Subsubsection",
 CellChangeTimes->{{3.9320375141196713`*^9, 3.9320375141206737`*^9}, {
  3.932148064971242*^9, 
  3.9321480970238805`*^9}},ExpressionUUID->"527d0530-d566-4d03-ac0c-\
8c37b3dfb509"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Following", " ", "Seciton", " ", "2", "C", " ", "from", " ", "previously",
     " ", "mentioned", " ", "manual"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"RbTemp", " ", "=", " ", "320"}], ";"}], " ", 
   RowBox[{"(*", "K", "*)"}], "\n", 
   RowBox[{
    RowBox[{"RbMass", " ", "=", " ", "1.42*^-25"}], ";"}], " ", 
   RowBox[{"(*", "Kg", "*)"}], "\n", 
   RowBox[{
    RowBox[{"transitionFrequency", " ", "=", " ", "3.84*^14"}], ";"}], " ", 
   RowBox[{"(*", "Hz", "*)"}], "\n", 
   RowBox[{
    RowBox[{"laserWavelength", " ", "=", " ", "780*^-9"}], ";"}], " ", 
   RowBox[{"(*", "m", "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Rho]", " ", "=", " ", 
     RowBox[{"(*", 
      RowBox[{"gas", " ", "density"}], "*)"}], "\n", 
     RowBox[{"\[Tau]", " ", "=", " ", 
      RowBox[{"(*", 
       RowBox[{
       "radiative", " ", "lifetime", " ", "of", " ", "upper", " ", 
        "electronic", " ", "state"}], "*)"}], "\n", 
      RowBox[{"g1", " ", "=", " ", 
       RowBox[{"(*", 
        RowBox[{
        "statistical", " ", "weigth", " ", "of", " ", "lower", " ", "state"}],
         "*)"}], "\n", 
       RowBox[{"g2", " ", "=", " ", 
        RowBox[{"(*", 
         RowBox[{
         "statistical", " ", "weigth", " ", "of", " ", "uper", " ", "state"}],
          "*)"}], "\n", 
        RowBox[{"DopplerWidth", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", "3*^-20", ")"}], "transitionFrequency", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["RbTemp", "RbMass"], ")"}], 
           RowBox[{"1", "/", "2"}]]}]}]}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2", "C"}], "-", "5"}], "*)"}], "\n", 
   RowBox[{"absorptionCoefficient", " ", "=", " ", 
    RowBox[{
     FractionBox["2", "DopplerWidth"], "*", 
     FractionBox[
      RowBox[{"laserWavelength", "^", "2"}], 
      RowBox[{"8", " ", "Pi"}]], "*", 
     FractionBox["g1", "g2"], "*", 
     FractionBox["\[Rho]", "\[Tau]"]}]}]}]}]], "Code",
 CellChangeTimes->{{3.9321481273390317`*^9, 3.9321481466242075`*^9}, {
  3.9321482135170727`*^9, 3.9321482444747095`*^9}, {3.9321483126625986`*^9, 
