    RowBox[{"NumDensity", " ", "=", " ", 
     RowBox[{"AtomsPerMM", "/", "RbBeamCrossSection"}]}], ";"}], "\n", "\n", "\n", 
   RowBox[{
    RowBox[{"\[Sigma]RbRes", " ", "=", " ", 
