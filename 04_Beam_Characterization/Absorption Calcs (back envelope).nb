   RowBox[{
    RowBox[{"RbMass", " ", "=", " ", 
     RowBox[{"Quantity", "[", 
      RowBox[{"1.419*^-25", ",", " ", "\"\<kg\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"RbDiameter", " ", "=", " ", 
     RowBox[{"Quantity", "[", 
      RowBox[{"495", ",", " ", "\"\<picometer\>\""}], "]"}]}], ";"}], "\n", "\n", 
