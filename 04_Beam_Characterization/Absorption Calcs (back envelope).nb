   RowBox[{"(*", 
    RowBox[{"Observing", " ", "cross", " ", "section", " ", "with", " ", 
     RowBox[{"depth", " ", "~", "3"}], " ", "mm"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"BeamWaist", " ", "=", " ", 
