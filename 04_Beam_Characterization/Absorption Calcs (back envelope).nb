        RowBox[{"8", " ", "kB", " ", "TempOven"}], 
        RowBox[{"Pi", " ", "RbMass"}]], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"AtomsPerMM", " ", "=", " ", 
     RowBox[{"UnitConvert", "[", 
