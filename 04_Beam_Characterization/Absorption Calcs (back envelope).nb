      FractionBox["3", 
       RowBox[{"2", "Pi"}]], "*", 
      RowBox[{"Quantity", "[", 
       RowBox[{
        SuperscriptBox["780", "2"], ",", 
        SuperscriptBox["\"\<nm\>\"", "2"]}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"\[Tau]", " ", "=", " ", 
     RowBox[{"NumDensity", "*", 
      RowBox[{"Quantity", "[", 
       RowBox[{"6.5", ",", "\"\<mm\>\""}], "]"}], "*", "\[Sigma]RbRes"}]}], 
    ";"}], "\n", "\n", "\n", 
   RowBox[{"100", "*", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "\[Tau]"}], "]"}]}], ")"}]}], "\n", "\n", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"NumDensity", ",", 
