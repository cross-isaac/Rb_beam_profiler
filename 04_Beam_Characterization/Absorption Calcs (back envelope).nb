Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Physical", " ", "Constants"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"kB", " ", "=", " ", 
