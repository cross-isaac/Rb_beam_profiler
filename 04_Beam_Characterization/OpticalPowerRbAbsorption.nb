Cell["Throlabs PDA36A Power to Voltage reading", "Subsubsection",
 CellChangeTimes->{{3.962381727605976*^9, 
  3.962381739017172*^9}},ExpressionUUID->"737fdb23-c3d6-2742-b094-\
52dc670565a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"www", ".", "thorlabs", ".", "com"}], "/", "drawings"}], "/", 
      "cdefa3930dd9be61"}], "-", 
     RowBox[{"69651", "DA2"}], "-", "C669", "-", "F85E", "-", 
     RowBox[{"B38467DFDD0335B1", "/", "PDA36A"}], "-", 
     RowBox[{"Manual", ".", "pdf"}]}]}], "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Responsivity780", " ", "=", " ", 
     RowBox[{"Quantity", "[", 
      RowBox[{"0.48", ",", " ", 
       RowBox[{"\"\<Amperes\>\"", "/", "\"\<Watts\>\""}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{"From", " ", "Plot"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Gain60dB", " ", "=", " ", 
     RowBox[{"Quantity", "[", 
      RowBox[{"1.5*^6", ",", " ", 
       RowBox[{"\"\<Volts\>\"", "/", "\"\<Amperes\>\""}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{"From", " ", "Table"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Gain70dB", " ", "=", " ", 
     RowBox[{"Quantity", "[", 
      RowBox[{"4.75*^6", ",", " ", 
       RowBox[{"\"\<Volts\>\"", "/", "\"\<Amperes\>\""}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{"From", " ", "Table"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ScaleFactor", " ", "=", " ", "1"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "1", "M\[CapitalOmega]", " ", "scope", " ", "impedence", " ", "so", " ", 
     "approx", " ", "1"}], "*)"}], "\n", "\n", 
   RowBox[{
    RowBox[{"VoltageOut", "[", "Power_", "]"}], " ", ":=", " ", 
    RowBox[{
    "ScaleFactor", "*", "Responsivity780", "*", "Gain70dB", "*", "Power"}]}], 
   " ", "\n", 
   RowBox[{
    RowBox[{"PowerIn", "[", "Voltage_", "]"}], " ", ":=", " ", 
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{"Voltage", "/", 
       RowBox[{"(", 
        RowBox[{"ScaleFactor", "*", "Responsivity780", "*", "Gain70dB"}], 
        ")"}]}], ",", "\"\<uW\>\""}], "]"}]}], "\n", "\n", 
   RowBox[{"VoltageOut", "[", "LinearAbsorptionPower", "]"}], "\n", 
   RowBox[{"PowerIn", "[", 
    RowBox[{"Quantity", "[", 
     RowBox[{"0.82", ",", "\"\<V\>\""}], "]"}], "]"}]}]}]], "Code",
