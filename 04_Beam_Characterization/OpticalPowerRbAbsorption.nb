 RowBox[{
  RowBox[{"HorizontalBeamWaist", " ", "=", " ", 
   RowBox[{"Quantity", "[", 
    RowBox[{"0.548", ",", " ", "\"\<mm\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BeamArea", " ", "=", " ", 
   RowBox[{"Pi", "*", 
