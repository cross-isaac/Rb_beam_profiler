 RowBox[{
  RowBox[{
   RowBox[{"LinearAbsorptionIntensity", " ", "=", " ", 
    RowBox[{"0.1", "*", "SaturationIntensity"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"LinearAbsorptionPower", " ", "=", " ", 
  RowBox[{"UnitConvert", "[", 
